{
  "name": "atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start",
    "local": "node scripts/run-local.mjs",
    "executor": "node scripts/run-executor.mjs",
    "test:mt5": "python -m unittest discover -s gateways/mt5 -p test_*.py",
    "test:profitdll": "python -m unittest discover -s gateways/profitdll -p test_*.py",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:check": "vitest run tests/database.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "decimal.js": "10.6.0",
    "lucide-react": "1.45.0",
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "three": "^0.170.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.170.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.1",
    "supabase": "2.117.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.4"
    }
  }
}
