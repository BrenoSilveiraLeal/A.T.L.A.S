# Server-only. Never paste real secrets in source, chat, or Git.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ATLAS_OWNER_ID=
ATLAS_APP_URL=http://127.0.0.1:3000
BRAPI_API_TOKEN=
CRON_SECRET=
ATLAS_OWNER_PIX_KEY=
# Configuration alone never authorizes execution. No certified broker ships yet.
LIVE_TRADING_ENABLED=false
# Optional isolated Executor. Enable reads only after configuring the official terminal.
ATLAS_EXECUTOR_ENABLED=false
EXECUTOR_SECRET=
ATLAS_GATEWAY_URL=http://127.0.0.1:8785
ATLAS_GATEWAY_TOKEN=
# Genial: GENIAL_MT5_SWING (must equal the bridge profile's provider id). See docs/research/GENIAL_MT5_INTEGRATION.md
ATLAS_GATEWAY_PROVIDER_ID=MT5
ATLAS_GATEWAY_ACCOUNT_ID=
# true for HTTPS deployments, false only for local HTTP verification
SESSION_COOKIE_SECURE=false
# Optional owner alerts via a private Telegram bot (@BotFather). Leave empty to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Local development only (never on Vercel): skip login on 127.0.0.1
ATLAS_DEV_AUTH_BYPASS=false
